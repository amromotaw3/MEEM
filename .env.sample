# Copy this to a local .env file and fill the values. DO NOT commit your real .env to version control.

# Supabase (server + Electron main process)
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Required for Electron login/register and Vercel API routes (never expose in the client/renderer)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend URL used by the Electron client when running locally
MEDIAVAULT_BACKEND_URL=http://localhost:3000

# Optional: any other env vars
# Example: LOG_LEVEL=debug

# Optional: Super Admin email address (defaults to amro.motawa@icloud.com if not specified)
SUPER_ADMIN_EMAIL=amro.motawa@icloud.com
