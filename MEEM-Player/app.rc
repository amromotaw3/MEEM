#include <windows.h>

IDI_ICON1 ICON DISCARDABLE "assets\\appicon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,10,3,0
PRODUCTVERSION  3,10,3,0
FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
FILEFLAGS       0x1L
#else
FILEFLAGS       0x0L
#endif
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "MEEM"
            VALUE "FileDescription",  "Official MEEM Desktop Media Player - Native player fully integrated and compatible with MEEM"
            VALUE "FileVersion",      "3.10.3.0"
            VALUE "InternalName",     "MEEM-Player"
            VALUE "LegalCopyright",   "Copyright (C) 2026 MEEM. All rights reserved."
            VALUE "OriginalFilename", "MEEM-Player.exe"
            VALUE "ProductName",      "MEEM Player"
            VALUE "ProductVersion",   "3.10.3.0"
            VALUE "Comments",         "Official primary media player for the MEEM app. Supports high-performance streaming, subtitles, and hardware-accelerated playback."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
