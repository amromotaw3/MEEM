{
  "name": "meem",
  "version": "3.10.9",
  "description": "MEEM — Play Anything. Anytime.",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amromotaw3/MEEM-Landing.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci",
    "lint": "eslint \"src/**/*.{js,mjs}\" --ext .js --color",
    "lint:fix": "eslint \"src/**/*.{js,mjs}\" --ext .js --fix",
    "prebuild": "node -e \"try { require('fs').rmSync('build_out', {recursive:true, force:true}); } catch(e) {}\"",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "release": "node scripts/run-release.js",
    "release:ci": "npm run release",
    "web:preview": "npx http-server src/renderer",
    "mobile:sync": "cap sync android",
    "mobile:open": "cap open android",
    "mobile:build": "cd android && .\\gradlew.bat assembleDebug"
  },
  "keywords": [
    "media",
    "player",
    "electron",
    "video",
    "tmdb",
    "downloader"
  ],
  "author": "MEEM",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "app-builder-bin": "^4.2.0",
    "electron": "^30.1.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.48.0",
    "jest": "^29.6.1",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.1",
    "shaka-player": "^5.1.5",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.meem.app",
    "productName": "MEEM",
    "copyright": "Copyright © 2026 MEEM",
    "directories": {
      "output": "build_out"
    },
    "extraResources": [
      {
        "from": "../MEEM Player",
        "to": "MEEM-Player",
        "filter": [
          "MEEM-Player.exe",
          "*.dll",
          "!Qt6*d.dll",
          "plugins/**/*",
          "!plugins/**/*d.dll",
          "platforms/**/*",
          "!platforms/**/*d.dll",
          "imageformats/**/*",
          "!imageformats/**/*d.dll",
          "iconengines/**/*",
          "!iconengines/**/*d.dll",
          "tls/**/*",
          "!tls/**/*dd.dll",
          "translations/**/*",
          "generic/**/*",
          "!generic/**/*d.dll",
          "networkinformation/**/*",
          "!networkinformation/**/*d.dll",
          "assets/**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/youtube-dl-exec/bin/**/*",
      "**/node_modules/ffmpeg-static/**/*",
      "**/node_modules/ffprobe-static/bin/win32/x64/**/*",
      "**/node_modules/webtorrent/**/*",
      "**/node_modules/youtubei.js/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "imgs/**/*",
      "ico/**/*",
      "src/**/*",
      "package.json",
      "src/renderer/imgs/**/*",
      "!**/node_modules/ffprobe-static/bin/darwin/**/*",
      "!**/node_modules/ffprobe-static/bin/linux/**/*",
      "!**/node_modules/ffprobe-static/bin/win32/ia32/**/*",
      "!**/node_modules/youtube-dl-exec/bin/*.old"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/renderer/imgs/appicon.ico",
      "electronLanguages": [
        "en-US",
        "ar"
      ],
      "publish": [
        {
          "provider": "github",
          "owner": "amromotaw3",
          "repo": "MEEM-Landing"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MEEM",
      "installerIcon": "src/renderer/imgs/appicon.ico",
      "uninstallerIcon": "src/renderer/imgs/appicon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeaderIcon": "src/renderer/imgs/appicon.ico",
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "warningsAsErrors": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@supabase/supabase-js": "^2.106.1",
    "adm-zip": "^0.5.17",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "bonjour": "^3.5.1",
    "cheerio": "^1.2.0",
    "discord-rpc": "^4.0.1",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "*",
    "ip": "^2.0.1",
    "libass-wasm": "^4.1.0",
    "mime-types": "^3.0.2",
    "music-metadata": "^10.0.0",
    "node-machine-id": "^1.1.12",
    "opensubtitles-api": "^5.1.2",
    "play-dl": "^1.9.7",
    "radio-browser-api": "^6.0.3",
    "torrent-stream": "^1.2.1",
    "webtorrent": "^2.8.5",
    "youtube-dl-exec": "^3.1.4",
    "youtubei.js": "^18.0.0"
  }
}
